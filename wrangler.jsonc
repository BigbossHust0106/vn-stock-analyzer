{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vn-stock-analyzer",
  "main": "worker/src/index.ts",
  "keep_vars": true,
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "limits": { "cpu_ms": 30000 },
  "assets": {
    "directory": "./web/out",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/health"],
  },
  "vars": { "NEWS_RSS_PERMISSION": "personal-nonprofit", "NEWS_WEIGHT": "0.1" },
  "triggers": {
    "crons": ["*/30 * * * *", "*/5 2-8 * * 1-5", "15 8 * * 1-5", "0 9 * * 1-5"],
  },
  "observability": { "enabled": true },
}
