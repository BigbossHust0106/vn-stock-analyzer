{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vn-stock-analyzer",
  "main": "worker/src/index.ts",
  "keep_vars": true,
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "16010801",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "ANALYSIS_RATE_LIMIT",
      "namespace_id": "16010802",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web/out",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/health"],
  },
  "vars": { "NEWS_RSS_PERMISSION": "personal-nonprofit", "NEWS_WEIGHT": "0.1" },
  "triggers": {
    "crons": [
      "* * * * *",
      "*/30 * * * *",
      "* 2-8 * * 1-5",
      "15 8 * * 1-5",
      "0 9 * * 1-5",
    ],
  },
  "observability": { "enabled": true },
}
