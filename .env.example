# Không điền credential vào file được commit. Browser chỉ dùng publishable key.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_WORKER_URL=""
# Worker: wrangler secret put NAME; local: worker/.dev.vars (ignored).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Endpoint hiện tại được cố định theo nguồn người dùng xác nhận, không có endpoint OHLCV.
SUPABASE_PUBLISHABLE_KEY=""
# Kiểm tra live độc lập, chỉ cấu hình mã chứng khoán (không phải secret).
VPS_LIVE_SYMBOLS=ACB
# Cache npm cho môi trường cloud hạn chế quyền ghi HOME.
npm_config_cache=/workspace/.npm-cache
