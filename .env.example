# Không điền credential vào file được commit. Browser chỉ dùng publishable key.
NEXT_PUBLIC_SUPABASE_URL="https://aszceahzutkhqfpyclev.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_WORKER_URL="https://vn-stock-analyzer.manhhuong.workers.dev"
# Worker: wrangler secret put NAME; local: .dev.vars ở root (ignored).
SUPABASE_URL="https://aszceahzutkhqfpyclev.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PUBLISHABLE_KEY=""
# Phần 2: danh mục KBS, quote/metadata VPS, history VPS hoặc KBS.
CATALOG_PROVIDER=kbs
QUOTE_PROVIDER=vps
HISTORY_PROVIDER=vps
FUNDAMENTALS_PROVIDER=kbs
# Secret tùy chọn: BCTC dự phòng FireAnt khi KBS lỗi. Đặt bằng Cloudflare secret, không commit.
FIREANT_API_TOKEN=
SYNC_SYMBOLS=VNM,FPT,HPG,VHC,DGC,REE,PNJ,MWG,GMD,DCM,DPM,NT2,BMP,NTP,PTB,QNS,VCS,PLC,IDC,VEA,SAB,MSN,PAN,CSV,PHR,DPR,TRC,HT1,HDG,DHG,IMP,TRA,SIP,VSC,FMC
# Chỉ dành cho scripts/sync-market.ts; nhập credential qua Environment Secrets.
SUPABASE_PROJECT_REF=aszceahzutkhqfpyclev
SUPABASE_ACCESS_TOKEN=""
# Token phải thuộc account chứa namespace manhhuong.workers.dev.
CLOUDFLARE_ACCOUNT_ID="9a0d6d0c169959b70222e98819280fe7"
CLOUDFLARE_API_TOKEN=""
# Kiểm tra live độc lập, chỉ cấu hình mã chứng khoán (không phải secret).
VPS_LIVE_SYMBOLS=ACB
# Cache npm cho môi trường cloud hạn chế quyền ghi HOME.
npm_config_cache=/workspace/.npm-cache
# Phần 6: chỉ Worker đọc khóa LLM; không có NEXT_PUBLIC_ cho credential.
NEWS_LLM_API_KEY=""
# Gốc API tương thích OpenAI; code sẽ nối /chat/completions.
NEWS_LLM_BASE_URL="https://api.openai.com/v1"
NEWS_LLM_MODEL=""
# Đã xác nhận dùng cá nhân/phi lợi nhuận; thương mại cần quyền sử dụng riêng.
NEWS_RSS_PERMISSION="personal-nonprofit"
NEWS_WEIGHT="0.1"

# Phần 7: Resend, chỉ Worker đọc. FROM thuộc domain đã xác minh.
ALERT_EMAIL_API_KEY=""
ALERT_EMAIL_FROM=""

# Emergency IO control (Worker variable, not secret). Pauses bulk financial/news/ranking
# work; live quote reads and watchlist alert maintenance remain available.
PAUSE_BULK_SYNC=false
